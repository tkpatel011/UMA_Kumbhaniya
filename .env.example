# ==============================================================================
# UMA Kumbhaniya AI Concierge — Environment Configuration
# ==============================================================================

PORT=3000

# 1. Groq API Key (Recommended for ultrafast Llama-3.3-70b / Llama-3.1-8b inference)
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY=GROQ_API_KEY=your_groq_api_key_here

# 2. Model Name (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, llama3-70b-8192)
LLAMA_MODEL=llama-3.3-70b-versatile

# 3. Custom OpenAI-compatible Llama API URL (Optional, defaults to Groq)
# LLAMA_API_URL=https://api.groq.com/openai/v1/chat/completions
